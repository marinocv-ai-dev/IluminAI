# Copy to .env.local and set your key. .env.local is NOT committed (*.local in .gitignore).
# On Vercel: Settings → Environment Variables, same 4 variables.

# --- OpenAI (the only model used by IluminAI) ---
# gpt-5.4-mini: passed the live eval (eval/ask_eval.ts) with 100% valid ids and the LoF/GoF warning in all roles.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini
LLM_KEY=sk-YOUR_KEY_HERE
LLM_EXTRA={"reasoning_effort":"low"}

# --- Optional: agent tools ---
# BRIGHT_DATA_API_TOKEN=
